generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// SIGEX · Sistema Integral de Gestión de Expedientes
// Schema para Prisma 6 + PostgreSQL


// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum EstatusExpediente {
  abierto
  en_revision
  cerrado

  @@map("estatus_expediente")
}

enum PrioridadExpediente {
  baja
  media
  alta
  urgente

  @@map("prioridad_expediente")
}

// ─────────────────────────────────────────────
// Seguridad: usuarios, roles y permisos
// ─────────────────────────────────────────────

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(150)
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  rolId         Int      @map("rol_id")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  rol                     Rol                 @relation(fields: [rolId], references: [id], onDelete: Restrict)
  sesiones                Sesion[]
  tokensRecuperacion      TokenRecuperacion[]
  expedientesCreados      Expediente[]        @relation("ExpedienteCreadoPor")
  expedientesActualizados Expediente[]        @relation("ExpedienteActualizadoPor")
  bitacora                Bitacora[]

  @@index([rolId])
  @@map("usuarios")
}

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(50) // Admin, Supervisor, Capturista, Consulta
  descripcion String? @db.VarChar(255)

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          Int     @id @default(autoincrement())
  clave       String  @unique @db.VarChar(100) // ej. expedientes:editar
  descripcion String? @db.VarChar(255)

  roles RolPermiso[]

  @@map("permisos")
}

// Tabla pivote N:M con llave compuesta
model RolPermiso {
  rolId     Int @map("rol_id")
  permisoId Int @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
  @@map("rol_permisos")
}

// ─────────────────────────────────────────────
// Autenticación: sesiones y recuperación
// ─────────────────────────────────────────────

model Sesion {
  // Lo genera la app con un valor aleatorio seguro (crypto.randomBytes)
  id        String   @id @db.VarChar(128)
  usuarioId Int      @map("usuario_id")
  expiraEn  DateTime @map("expira_en") @db.Timestamptz(6)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesiones")
}

model TokenRecuperacion {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255) // nunca el token en claro
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz(6)
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

// ─────────────────────────────────────────────
// Negocio: expedientes
// ─────────────────────────────────────────────

model Expediente {
  id               Int                 @id @default(autoincrement())
  folio            String              @unique @db.VarChar(30)
  titulo           String              @db.VarChar(200)
  descripcion      String?             @db.Text
  solicitante      String              @db.VarChar(200)
  estatus          EstatusExpediente   @default(abierto)
  prioridad        PrioridadExpediente @default(media)
  creadoPorId      Int                 @map("creado_por")
  actualizadoPorId Int?                @map("actualizado_por")
  creadoEn         DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime            @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  eliminadoEn      DateTime?           @map("eliminado_en") @db.Timestamptz(6) // baja lógica

  creadoPor      Usuario  @relation("ExpedienteCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  actualizadoPor Usuario? @relation("ExpedienteActualizadoPor", fields: [actualizadoPorId], references: [id], onDelete: Restrict)

  @@index([estatus])
  @@index([prioridad])
  @@index([eliminadoEn])
  @@index([creadoPorId])
  @@map("expedientes")
}

// ─────────────────────────────────────────────
// Auditoría: solo inserción
// ─────────────────────────────────────────────

model Bitacora {
  id                Int      @id @default(autoincrement())
  usuarioId         Int?     @map("usuario_id") // null = acción del sistema o anónima (ej. login fallido)
  accion            String   @db.VarChar(50)
  entidad           String   @db.VarChar(50)
  entidadId         String?  @map("entidad_id") @db.VarChar(128)
  valoresAnteriores Json?    @map("valores_anteriores") @db.JsonB
  valoresNuevos     Json?    @map("valores_nuevos") @db.JsonB
  ip                String?  @db.VarChar(45) // soporta IPv6
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@index([creadoEn])
  @@map("bitacora")
}

